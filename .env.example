# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Google sign-in (Supabase Auth; read by `supabase start`) --------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- API process (pnpm --filter @funmem/api start) -------------------------
FUNMEM_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
FUNMEM_SUPABASE_URL=http://127.0.0.1:54321
# bge-m3 (default) downloads a 568 MB model on first start; `deterministic` starts at once
# and keeps keyword search, without semantic search
# FUNMEM_EMBEDDING_PROVIDER=deterministic

# --- NVIDIA NIM: interview ingestion and the assistant ---------------------
# Without it, an import still works and keeps every memory in the speaker's own words.
NVIDIA_API_KEY=

# --- Deepgram: live interview transcription ---------------------------------
# console.deepgram.com -> API Keys (a Member key is enough). The browser never sees it: the API
# (and, in demo mode, the Vite dev server) trades it for a one-minute token per recording.
DEEPGRAM_API_KEY=

# The live interview coach (after each answer, the next move to suggest) uses the same NVIDIA
# key with a fast model of its own, so a suggestion arrives within a pause. Optional.
# INTERVIEW_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
