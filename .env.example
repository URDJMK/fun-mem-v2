# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Google sign-in (Supabase Auth; read by `supabase start`) --------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- API process (pnpm --filter @funmem/api start) -------------------------
FUNMEM_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
FUNMEM_SUPABASE_URL=http://127.0.0.1:54321
# bge-m3 (default) downloads a 568 MB model on first start; `deterministic` starts at once
# and keeps keyword search, without semantic search
# FUNMEM_EMBEDDING_PROVIDER=deterministic

# --- NVIDIA NIM: interview ingestion and the assistant ---------------------
# Without it, an import still works and keeps every memory in the speaker's own words.
NVIDIA_API_KEY=
